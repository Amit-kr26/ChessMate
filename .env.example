# PostgreSQL Configuration
# NOTE: change defaults in production – generate strong 32-char password
POSTGRES_HOST=postgres
POSTGRES_DB=chess_assistant
POSTGRES_USER=chess_assistant
POSTGRES_PASSWORD=CHANGE_ME_32_char_random_generate_me
POSTGRES_PORT=5432

# Elasticsearch Configuration
# 127.0.0.1 binding in docker-compose mitigates unauthenticated 9200; for public hosts set xpack.security.enabled=true + ELASTIC_PASSWORD
ELASTIC_URL_LOCAL=http://localhost:9200
ELASTIC_URL=http://elasticsearch:9200
ELASTIC_PORT=9200
INDEX_NAME=chess-rag

# OpenAI / LLM Gateway Configuration – base_url + model are env-driven (gateway testing)
# For direct OpenAI: leave OPENAI_BASE_URL empty (defaults to https://api.openai.com/v1)
# For gateway (e.g. llmgateway, LiteLLM): set e.g. OPENAI_BASE_URL=http://llmgateway:4000/v1  or LLM_GATEWAY_URL=http://localhost:4000/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
# also accepted: OPENAI_API_BASE, LLM_GATEWAY_URL, LLM_BASE_URL (any one)
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EVAL_MODEL=gpt-3.5-turbo
EVAL_SAMPLE_RATE=0.2

# Chess Engine
STOCKFISH_PATH=stockfish
ENGINE_DEPTH=15
ENGINE_TIMEOUT=0.15

# Streamlit
STREAMLIT_PORT=8501
APP_ENV=development

# Grafana – must set strong password, no default admin fallback
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_pwd
